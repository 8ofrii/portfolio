<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0d1527" />
      <stop offset="100%" stop-color="#050811" />
    </linearGradient>
    <linearGradient id="neonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00f2fe" />
      <stop offset="50%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#0284c7" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Background Squircle -->
  <rect width="64" height="64" rx="16" fill="url(#bgGrad)" />
  
  <!-- Subtle Glowing Border -->
  <rect x="1.5" y="1.5" width="61" height="61" rx="14.5" fill="none" stroke="url(#neonGrad)" stroke-width="1.8" stroke-opacity="0.45" />

  <!-- Outer Glow of the M -->
  <path d="M17 46 L17 19 L32 33 L47 19 L47 46" fill="none" stroke="#00f2fe" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" opacity="0.3" filter="url(#glow)" />

  <!-- Core Crisp Geometric M -->
  <path d="M17 46 L17 19 L32 33 L47 19 L47 46" fill="none" stroke="url(#neonGrad)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Automation Energy Accent Node -->
  <circle cx="32" cy="19" r="3.2" fill="#00f2fe" />
  <circle cx="32" cy="19" r="1.5" fill="#ffffff" />
</svg>
